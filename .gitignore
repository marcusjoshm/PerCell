# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
# Generated by setuptools-scm at build/install time; never committed.
src/percell4/_version.py
dist/
build/
*.whl

# Virtual environments
.venv/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Testing / linting
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db

# Data files (large, not version controlled)
*.h5
*.sdt
*.ptu
*.bin
*.lif
*.czi

# Test / scratch outputs from running the app
*.csv
*.xlsx
*.xls
# ...but test-fixture CSVs are committed parity baselines the suite reads.
!tests/fixtures/**/*.csv

# R
.Rhistory
.Rdata
.Rproj.user/

# Local agent context — kept on disk but never pushed to the remote
# repo. Agent-generated DOCUMENTATION (docs/solutions/, docs/audits/,
# etc.) is still tracked; only the per-developer context-engineering
# files and tool hooks are excluded here.
.claude/
.cursor/
CLAUDE.md
compound-engineering.local.md
.worktrees

# Developer scratch: one-off data-propagation scripts, ImageJ macros, and
# tool hooks. Kept on disk for reuse but never part of the tracked platform.
scripts/

# Retired development artifact (adaptive SG puncta recipe), archived but untracked.
docs/archive/locked_SG.json

# Agent / tool context caches
.context/

# Scratch SVG exports at repo root (analysis runs).
# docs/**/*.svg and src/**/*.svg remain trackable.
/*.svg

# Separate Tauri/Node desktop-app project living in the repo dir (incl. node_modules).
/desktop/

# Stray Claude Code installer that lands in the repo root on download.
# Not a PerCell4 installer -- see docs/audits/readme-documentation-audit-2026-08-13.md.
/install.sh
